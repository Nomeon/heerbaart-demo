# Loaded from .env by default; existing environment variables take priority.
# Set ENV_FILE to use a different file. NX paths below are Windows examples.

# --- Single-process API; use this laptop's NetBird address for remote calls ---
NX_HOST=127.0.0.1
NX_PORT=9009

# --- Backend status callbacks; use the backend's NetBird address if remote ---
NX_CALLBACK_URL=http://localhost:8001
NX_CALLBACK_API_KEY=
NX_CALLBACK_STATUS_PATH=/jobs/status
NX_CALLBACK_TIMEOUT=10

# --- Local uploads, family state, NX parts, and logs; no automatic cleanup ---
NX_DATA_DIR=data

# --- Siemens NX 2512 and custom machine/jaw resources ---
NX_INSTALL_DIR="C:/Program Files/Siemens/DesigncenterNX2512"
NX_CUSTOM_DIR=C:/Heerbaart/NX2512_Custom/NX2512_Custom
# Simulation only: same Okuma CSE/tool library as Heerbaart_NX2512.bat.
# Clone/update/refresh/CAM/post and the article's references keep NX_CUSTOM_DIR.
NX_SIMULATION_CUSTOM_DIR=C:/Heerbaart_Custom/__Custom
# Optional: leave unset to use the active Pixi environment (sys.prefix).
# NX_PYTHON_HOME=C:/path/to/service/.pixi/envs/default
NX_JOURNAL_TIMEOUT=900

# --- Required only for PDF extraction, not for article-only jobs ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1

# --- Worker ---
# Wait before restarting the loop after it dies.
NX_WORKER_RESTART_DELAY=1

# --- Logging ---
NX_LOG_LEVEL=INFO
